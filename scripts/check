#!/bin/zsh
set -euo pipefail

root="${0:A:h:h}"
cd "$root"

if [[ ! -f Local.xcconfig ]]; then
  echo "check: Local.xcconfig is missing; see docs/build-and-run.md" >&2
  exit 1
fi
team="$(awk -F'=' '/^[[:space:]]*DEVELOPMENT_TEAM[[:space:]]*=/ {gsub(/[[:space:]]/, "", $2); print $2}' Local.xcconfig)"
if [[ -z "$team" ]]; then
  echo "check: DEVELOPMENT_TEAM is empty in Local.xcconfig" >&2
  exit 1
fi

find_in_tracked_files() {
  local found="" output grep_status
  for place in "" "--cached"; do
    grep_status=0
    output="$(git grep ${place:+$place} "$@")" || grep_status=$?
    if (( grep_status == 0 )); then
      found+="$output"$'\n'
    elif (( grep_status != 1 )); then
      echo "check: git grep failed" >&2
      exit 1
    fi
  done
  printf '%s' "$found" | sort -u
}

echo "==> Team ID guard"
leaks="$(find_in_tracked_files -l -F -e "$team" -- .)"
if [[ -n "$leaks" ]]; then
  echo "check: the Team ID appears in these tracked or staged files:" >&2
  echo "$leaks" >&2
  exit 1
fi
echo "Team ID is in no tracked or staged file."

echo "==> swiftlint:disable ban"
disables="$(find_in_tracked_files -n -F -e "swiftlint:disable" -- '*.swift')"
if [[ -n "$disables" ]]; then
  echo "check: swiftlint:disable is banned (docs/swift-style.md rule 1):" >&2
  echo "$disables" >&2
  exit 1
fi
echo "No swiftlint:disable in tracked or staged Swift files."

echo "==> SwiftLint"
swiftlint lint --strict --quiet
echo "SwiftLint passed."

echo "==> Debug build"
build_log="$(mktemp)"
trap 'rm -f "$build_log"' EXIT
build_status=0
xcodebuild -project Umi.xcodeproj -scheme Umi -configuration Debug \
  -destination "platform=macOS,arch=$(uname -m)" -derivedDataPath build \
  -quiet build >"$build_log" 2>&1 || build_status=$?
sed -e "s/$team/<team>/g" "$build_log" >&2
if (( build_status != 0 )); then
  echo "check: the Debug build failed" >&2
  exit 1
fi
echo "Debug build passed."

echo "==> Tests"
test_log="$(mktemp)"
trap 'rm -f "$build_log" "$test_log"' EXIT
test_status=0
xcodebuild -project Umi.xcodeproj -scheme Umi \
  -destination "platform=macOS,arch=$(uname -m)" -derivedDataPath build \
  -quiet test >"$test_log" 2>&1 || test_status=$?
if (( test_status != 0 )); then
  sed -e "s/$team/<team>/g" "$test_log" >&2
  echo "check: the tests failed" >&2
  exit 1
fi
echo "Tests passed."

echo "All checks passed."
